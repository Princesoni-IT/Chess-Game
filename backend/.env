# ============================================
# 🔐 Chess Master - Environment Variables
# ============================================
# Copy this file and rename it to ".env"
# Then fill in YOUR values below
# ============================================
# Your MongoDB Connection URL
# If MongoDB is on your computer: mongodb://localhost:27017
# If using MongoDB Atlas (cloud): mongodb+srv://username:password@cluster.xxxxx.mongodb.net

MONGO_URL=mongodb://localhost:27017

# Database Name (you can change this)
MONGO_DB_NAME=chess_master

# Django Secret Key (keep this private!)
DJANGO_SECRET_KEY=django-insecure-change-this-to-a-random-string-in-production

# Debug Mode (set to False when deploying)
DEBUG=True